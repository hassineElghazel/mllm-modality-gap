    given-names: "Hassine"
    affiliation: "Politecnico di Torino"
repository-code: "https://github.com/hassineElghazel/mllm-modality-gap"
license: AGPL-3.0-or-later
keywords:
  - modality gap
  - multimodal large language models
  - representation geometry
  - image captioning
  - object hallucination
